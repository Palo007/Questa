# =============================================================================
# Questa - Whitelist .gitignore
# Only files from the reference repo (https://github.com/Palo007/Questa)
# are tracked. Everything else is ignored.
# =============================================================================

# Ignore everything at the root level
/*
!/.gitignore

# === Questa reference repo files (only these should ever be tracked) ===
!/INSTALL.md
!/app.js
!/habitica_to_questa.py
!/icon-192.png
!/icon-512.png
!/icon.svg
!/index.html
!/manifest.json
!/sw.js
!/README.md
!/sync.js
# === Documentation ===
# Living docs live in docs/ and ARE version-controlled. Leaving them untracked is
# what let the three join-daily-reset fixtures get silently overwritten in July
# 2026 with no way to restore them.
# README.md and INSTALL.md deliberately stay at the repo root (whitelisted above):
# GitHub renders README.md from the root, and INSTALL.md is expected there too.
!/docs/

# === Test and tool directories ===
!/tests/
!/tools/
# generated data + local scratch, never tracked
tools/out/
tests/_tmp_*
tests/.gfs_full.new
# archive/ is ignored wholesale EXCEPT archive/tests/, which tests/run.js executes.
# Order matters: gitignore is last-match-wins, so the blanket must precede the negation.
!/archive/
archive/*
!/archive/tests/

# === OS cruft ===
.DS_Store
Thumbs.db
desktop.ini

# === Editor / IDE ===
.vscode/
.idea/
*.swp

# === Logs / temp ===
*.log
*.tmp

# === Python cache ===
__pycache__/
*.pyc

# === Archives and backups ===
*.bak
*.bak-*
*.7z
*.zip
